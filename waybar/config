{
  "layer": "top",
  "position": "top",
  "margin-left":4,
  "margin-right":4,
  "margin-top":2,
  "margin-bottom":2,
  "spacing": 1,
  "css": "~/.config/waybar/style.css",  // Point to your CSS file
  "modules-left": [
      "custom/debian",
      "custom/sep",
      "cpu",
      "custom/sep",
      "memory",
      "custom/sep",
      "battery"
  ],
  "modules-center": [
      "clock",
        "custom/sep",
      "custom/weather"
  ],
  "modules-right": [
      "hyprland/workspaces",
    "custom/sep",
    "tray",
    "custom/sep",
    "hyprland/language",
    "custom/sep",
    "network",
    "custom/sep",
    "pulseaudio"
  ],
  "custom/debian": {
    "format": "  ",
    "on-click": "cd ~/.config/waybar/scripts && ./rofi-powermenu.sh",
    "tooltip": false
  },
  "custom/sep": {
    "format": "|"
  },
  "hyprland/language": {
      "format": "{short}"
  },
  "hyprland/workspaces": {
    "format": " {name} ",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "format-icons": {
      "active": "",
      "urgent": "",
      "default": ""
    }
  },
  "clock": {
    "tooltip": true,
    "format": "󰃰  {:%H:%M - %a  %d %b %Y} ",
    "tooltip-format": "{calendar}"
  },
  "custom/weather": {
      "exec": "~/.config/waybar/scripts/weather.sh",
      "interval": 600,
      "return-type": "json",
      "tooltip": true
  },
  "tray": {
    "icon-size": 15,
    "show-passive-items": "true"
  },
  "pulseaudio": {
    // "rotate": 90,
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "MUTE ",
    "format-icons": {
      "default": [
        " ",
        " "
      ]
    },
    "scroll-step": 3,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
  },
  "battery": {
    // "rotate": 90,
    "states": {
        "good": 95,
        "warning": 30,
        "critical": 15
    },
    "format-icons": {
        "default":[
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "format": "{icon}   {capacity}%",
    "format-charging": "  {capacity}%"
  },
  "network": {
    // "rotate": 90,
    "format-wifi": "{essid}  ",
    "format-disconnected": "Disconnected 󰖪 ",
    "tooltip": true,
    "tooltip-format": "{essid} : {ipaddr} "
  },
  "cpu":{
    // "rotate":90,
    "format":"   {usage}%"
  },
  "memory":{
    // "rotate":90,
    "format":"   {}%"
  }
}
